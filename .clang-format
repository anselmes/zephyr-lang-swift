# clang-format defaults to LLVM style, which puts one space before a trailing
# comment. cpplint (whitespace/comments) wants two, and the two tools must agree
# or each undoes the other. Everything else stays at the LLVM defaults.
BasedOnStyle: LLVM
SpacesBeforeTrailingComments: 2
