// Clang module map for ZephyrCore: the Zephyr C APIs and the C functions
// implemented in Swift, as declared in BridgingHeader.h. Package.swift exposes
// it as the ZephyrCore system library target.
module ZephyrCore {
  umbrella header "BridgingHeader.h"
  export *
}
