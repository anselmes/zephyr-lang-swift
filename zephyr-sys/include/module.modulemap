// Clang module map for ZephyrSystem: the Zephyr C APIs and the C functions
// implemented in Swift, as declared in ZephyrSystem.h. Package.swift exposes
// it as the ZephyrSystem system library target.
module ZephyrSystem {
  umbrella header "ZephyrSystem.h"
  export *
}
