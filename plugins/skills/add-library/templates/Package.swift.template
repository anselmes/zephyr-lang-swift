// The libraries of __name__, one target and product per directory under lib/.
// Applications add this package to their own Package.swift by path and depend
// on a library's product; SwiftPM compiles the library with the application.

import PackageDescription

// The Embedded Swift settings of every target. Declared before `package`:
// top-level manifest code runs in order, so a later declaration would still
// be empty when `package` reads it.
let settings: [SwiftSetting] = [
  .strictMemorySafety(),
  .enableUpcomingFeature("ExistentialAny"),
  .enableUpcomingFeature("InternalImportsByDefault"),
  .enableUpcomingFeature("MemberImportVisibility"),
  .enableExperimentalFeature("CImplementation"),
  .enableExperimentalFeature("Embedded"),
  .enableExperimentalFeature("Extern"),
]

// The zephyr-lang-swift checkout that `west build` uses, when CMake sets it.
let langSwiftPath = Context.environment["ZEPHYR_LANG_SWIFT_PATH"].flatMap { $0.isEmpty ? nil : $0 }

let package = Package(
  name: "__name__",
  products: [
    .library(name: "__Module__", targets: ["__Module__"])
  ],
  dependencies: [
    localOrRemotePackage(
      name: "zephyr-lang-swift",
      url: "https://github.com/anselmes/zephyr-lang-swift.git",
      path: langSwiftPath ?? "../modules/lang/swift",
    )
  ],
  targets: [
    .target(
      name: "__Module__",
      dependencies: [
        .product(name: "Zephyr", package: "zephyr-lang-swift")
      ],
      path: "lib/__module__",
      exclude: ["CMakeLists.txt", "Kconfig"],
      swiftSettings: settings,
    )
  ],
  swiftLanguageModes: [.v6],
)

// MARK: - Helpers

/// A dependency from a sibling checkout of the west workspace, or from its
/// repository.
///
/// The checkout is used when `__NAME___LOCAL_DEPS` is `1` or `true` (relative
/// `path`s resolve against this package), or names the directory that a
/// relative `path` is relative to. `west build` is always inside such a
/// workspace: CMake sets `ZEPHYR_LANG_SWIFT_PATH` for every `swift build` it
/// runs, which counts as `__NAME___LOCAL_DEPS=1`. An absolute `path` is used as
/// is. Every package that depends on zephyr-lang-swift should resolve it the
/// same way, so SwiftPM sees one package identity.
func localOrRemotePackage(
  name: String,
  url: String,
  path: String,
  from version: Version? = nil,
  branch: String = "main",
  traits: Set<Package.Dependency.Trait> = [.defaults],
) -> Package.Dependency {
  let local = Context.environment["__NAME___LOCAL_DEPS"].flatMap { $0.isEmpty ? nil : $0 } ?? (langSwiftPath == nil ? nil : "1")
  if let local {
    let root = (local == "1" || local == "true") ? Context.packageDirectory : local
    return .package(name: name, path: path.hasPrefix("/") ? path : "\(root)/\(path)", traits: traits)
  }
  if let version {
    return .package(url: url, from: version, traits: traits)
  }
  return .package(url: url, branch: branch, traits: traits)
}
