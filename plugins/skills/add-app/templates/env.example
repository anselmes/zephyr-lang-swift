# The west workspace is found from the current directory (needs `west` on PATH); set ZEPHYR_WORKSPACE first to override.
export ZEPHYR_WORKSPACE="${ZEPHYR_WORKSPACE:-$(west topdir)}"
export PATH="${PWD}/bin${PATH:+:${PATH}}"
. "${ZEPHYR_WORKSPACE}/zephyr/zephyr-env.sh"
. "${ZEPHYR_WORKSPACE}/.venv/bin/activate"
export TOOLCHAINS="swift"
export ZEPHYR_TOOLCHAIN_VARIANT="zephyr/llvm"
export ZEPHYR_BOARD="__board__"
