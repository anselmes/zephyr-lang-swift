# This file is sourced by a shell, not read as dotenv input, so the key, quoting,
# substitution and ordering checks of dotenv-linter do not apply to it.
# dotenv-linter:off IncorrectDelimiter
# dotenv-linter:off KeyWithoutValue
# dotenv-linter:off LeadingCharacter
# dotenv-linter:off LowercaseKey
# dotenv-linter:off QuoteCharacter
# dotenv-linter:off SubstitutionKey
# dotenv-linter:off UnorderedKey

# The west workspace is found from the current directory (needs `west` on PATH); set ZEPHYR_WORKSPACE first to override.
export ZEPHYR_WORKSPACE="${ZEPHYR_WORKSPACE:-$(west topdir)}"
export PATH="${PWD}/bin${PATH:+:${PATH}}"
. "${ZEPHYR_WORKSPACE}/zephyr/zephyr-env.sh"
. "${ZEPHYR_WORKSPACE}/.venv/bin/activate"
export TOOLCHAINS="swift"
export ZEPHYR_TOOLCHAIN_VARIANT="zephyr/llvm"
export ZEPHYR_BOARD="__board__"
